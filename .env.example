# Postgres
DB_USER=notes
DB_PASSWORD=change_me
DB_NAME=notes_app
DB_DATA_LOCATION=./postgres-data

# Media storage (relocate to another drive if desired, mirrors ImmichDocker's UPLOAD_LOCATION pattern)
UPLOAD_LOCATION=./uploads

# Ollama (host-native install, reached from containers via host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Anthropic (only needed if you switch the active provider to "anthropic" in Settings)
ANTHROPIC_API_KEY=
