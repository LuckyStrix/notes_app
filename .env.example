# Postgres
DB_USER=notes
DB_PASSWORD=change_me
DB_NAME=notes_app
DB_DATA_LOCATION=./postgres-data

# Media storage (relocate to another drive if desired, mirrors ImmichDocker's UPLOAD_LOCATION pattern)
UPLOAD_LOCATION=./uploads

# Where scheduled database backups (and manual media copies) are written.
# Point this at an external drive to keep backups off the machine they back up.
BACKUP_LOCATION=./backups

# Or send backups to a network share (SMB/CIFS) -- see docker-compose.nas.yml.
# Uncomment all of these; NAS_HOST / NAS_SHARE / NAS_BACKUP_PATH default to the values shown.
# COMPOSE_FILE=docker-compose.yml;docker-compose.nas.yml
# NAS_USER=
# NAS_PASSWORD=
# NAS_HOST=100.125.25.30
# NAS_SHARE=Lucky-NAS
# NAS_BACKUP_PATH=File Backups/notes_app_backups

# Ollama (host-native install, reached from containers via host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Anthropic (only needed if you switch the active provider to "anthropic" in Settings)
ANTHROPIC_API_KEY=
